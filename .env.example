# Local development defaults for the PFC Assistant API.
# Copy values into your shell environment as needed. No secrets are required for MVP.

# Chroma
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=pfc_corpus

# Models
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
OLLAMA_MODEL_NAME=llama3.1:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Generation / retrieval knobs
RESPONSE_LANGUAGE=Portuguese
RAG_CANDIDATE_K=40
RAG_RERANK_TOP_K=8
RAG_MAX_EVIDENCE_CHUNKS=5
RAG_MAX_EVIDENCE_CHARS=6000
RAG_USE_LLM_REWRITE=true

# API
# API_HOST=127.0.0.1
# API_PORT=8000
