# Local development defaults for the PFC Assistant API.
# Copy values into your shell environment as needed. No secrets are required for MVP.

# Chroma
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=pfc_corpus

# Models
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
OLLAMA_MODEL_NAME=llama3.1:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Generation / retrieval knobs
RESPONSE_LANGUAGE=Portuguese
RAG_CANDIDATE_K=40
RAG_RERANK_TOP_K=8
RAG_MAX_EVIDENCE_CHUNKS=5
RAG_MAX_EVIDENCE_CHARS=6000
RAG_USE_LLM_REWRITE=true

# API. The student interface is served on this host and port.
# API_HOST=127.0.0.1
# API_PORT=8000

# PFC catalogue and managed originals
PFC_DB_PATH=data/pfc.db
PFC_CORPUS_DIRECTORY=data/corpus
PFC_SAMPLES_DIRECTORY=data/pfc_samples

# Student frontend is served by this API at http://127.0.0.1:8000/
# Set CORS only when a browser page is hosted on another origin.
# CORS_ORIGINS=http://127.0.0.1:4173

# Anonymous timing log. Questions and answers are not written.
EVALUATION_LOG_PATH=data/evaluation/interactions.jsonl
